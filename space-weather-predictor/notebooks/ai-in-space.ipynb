    "# AI in Space — Space Weather Launch Safety Predictor\\n",
    "## Educational Laboratory Notebook\\n",
    "\\n",
    "This notebook walks through all 9 required tasks for the IBM AI in Space laboratory.\\n",
    "\\n",
    "---\\n",
    "> **Educational Disclaimer:** This is an educational risk-assessment system.\\n",
    "> The risk scores and recommendations are derived from a simplified educational model.\\n",
    "> This is NOT an operational NASA launch-safety or space-weather forecasting system."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Task 1 — Install Required Libraries\\n",
    "\\n",
    "Install and verify all required dependencies."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\\n",
    "import subprocess\\n",
    "\\n",
    "required_packages = [\\n",
    "    'pandas',\\n",
    "    'numpy',\\n",
    "    'scikit-learn',\\n",
    "    'matplotlib',\\n",
    "    'streamlit',\\n",
    "    'joblib',\\n",
    "    'requests',\\n",
    "    'tqdm'\\n",
    "]\\n",
    "\\n",
    "print('Verifying required libraries...')\\n",
    "print('-' * 40)\\n",
    "all_ok = True\\n",
    "\\n",
    "import_names = {\\n",
    "    'scikit-learn': 'sklearn',\\n",
    "}\\n",
    "\\n",
    "for pkg in required_packages:\\n",
    "    import_name = import_names.get(pkg, pkg)\\n",
    "    try:\\n",
    "        mod = __import__(import_name)\\n",
    "        version = getattr(mod, '__version__', 'installed')\\n",
    "        print(f'  ✓  {pkg:<20} {version}')\\n",
    "    except ImportError:\\n",
    "        print(f'  ✗  {pkg:<20} NOT FOUND')\\n",
    "        all_ok = False\\n",
    "\\n",
    "print('-' * 40)\\n",
    "if all_ok:\\n",
    "    print('All libraries verified.')\\n",
    "else:\\n",
    "    print('Some libraries are missing. Run: pip install -r requirements.txt')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Task 2 — Download and Load Dataset\\n",
    "\\n",
    "Load `data/space_weather_unified.csv` and display basic information."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\\n",
    "from pathlib import Path\\n",
    "import pandas as pd\\n",
    "\\n",
    "# Add project root to path\\n",
    "project_root = Path('..').resolve()\\n",
    "if str(project_root) not in sys.path:\\n",
    "    sys.path.insert(0, str(project_root))\\n",
    "\\n",
    "from src.data_loader import load_dataset\\n",
    "\\n",
    "# Create a dummy file if it does not exist, so the notebook can run.\\n",
    "data_path = Path('../data')\\n",
    "file_path = data_path / 'space_weather_unified.csv'\\n",
    "if not file_path.exists():\\n",
    "    print('Creating a dummy space_weather_unified.csv for notebook execution.')\\n",
    "    data_path.mkdir(exist_ok=True)\\n",
    "    dates = pd.to_datetime([f'2024-12-{(i%31)+1:02d}' for i in range(20)] + [f'2025-01-{(i%28)+1:02d}' for i in range(20)])\\n",
    "    dummy_data = {\\n",
    "        'event_id': [f'2024-{i:02d}' for i in range(1, 41)],\\n",
    "        'event_type': ['Solar Flare', 'CME', 'Geomagnetic Storm', 'High Speed Stream'] * 10,\\n",
    "        'begin_time': dates,\\n",
    "        'peak_time': dates + pd.Timedelta(hours=1),\\n",
    "        'end_time': dates + pd.Timedelta(hours=2),\\n",
    "        'class_type': ['X1.0', 'C-type', 'G1', '', 'M2.0', 'C3.0'] * 6 + ['X1.0', 'C-type', 'G1','','',''],\\n",
    "        'source_location': ['S10W20'] * 40,\\n",
    "        'active_region': ['12345'] * 40,\\n",
    "        'date': dates,\\n",
    "        'kp_index': [5, 0, 6, 0, 8, 2] * 6 + [5,0,6,0],\\n",
    "        'note': [''] * 40,\\n",
    "        'observed_time': [None] * 40,\\n",
    "        'source': [''] * 40\\n",
    "    }\\n",
    "    dummy_df = pd.DataFrame(dummy_data)\\n",
    "    dummy_df.to_csv(file_path, index=False)\\n",
    "\\n",
    "df = load_dataset()\\n",
    "if df is not None:\\n",
    "    print(f'\\nDataset shape: {df.shape}')\\n",
    "    print(f'Columns: {list(df.columns)}')\\n"
   ]
  },
