    "FEATURE_COLS = [\\n",
    "    'xclass_flare_count', 'mclass_flare_count', 'cclass_flare_count',\\n",
    "    'max_kp_index', 'avg_kp_index', 'storm_count', 'event_trend'\\n",
    "]\\n",
    "\\n",
    "model, X_train, y_train, X_test, y_test = train_model(scored_df)\\n",
    "\\n",
    "if model and not X_test.empty:\\n",
    "    evaluate_model(model, X_test, y_test, FEATURE_COLS)\\n",
    "else:\\n",
    "    print('Skipping evaluation as model or test data is not available.')"
   ]
